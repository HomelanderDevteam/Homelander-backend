# Copy this file to .env and fill it in. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty to use a local SQLite file. For PostgreSQL:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# Browsers calling the API from another address (web frontend / admin dashboard)
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# Login tokens
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Rate limits (per IP)
THROTTLE_LOGIN=20/min
THROTTLE_REGISTER=30/hour

# First admin for hosts without a shell (used by: python manage.py ensure_superuser)
ADMIN_PHONE_NUMBER=
ADMIN_PASSWORD=
